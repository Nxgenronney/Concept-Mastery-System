# ==============================================================================
# Closed-Loop Concept Mastery Platform - Environment Configuration Example
# Copy this file to .env and configure your keys.
# The platform functions offline with fallback heuristics if keys are omitted.
# ==============================================================================

# OpenRouter Unified Gateway (Primary Frontier & Auto-Failover)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# PageIndex API Key (for structured document hierarchy)
PAGEINDEX_API_KEY=

# Primary LLM: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Fallback LLM: Groq Cloud (Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# TinyFish Web Search API
TINYFISH_API_KEY=
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai

# ElevenLabs High-Speed Audio (Flash v2.5)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Generic LLM Provider (OpenAI / Anthropic compatible)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Storage paths
UPLOAD_DIR=../data/uploads
VECTOR_STORE_PATH=../data/vectorstore

# Google OAuth 2.0 & Session Security
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=concept-mastery-jwt-secret-key-32bytes
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
ENVIRONMENT=development

# Medical-student verification review (keep this secret; configure in deployment)
MEDICAL_VERIFICATION_REVIEW_TOKEN=
